# Copy to .env and fill in. Never commit .env.

# demo | live | auto (auto = live if a live snapshot exists, otherwise demo)
HEADROOM_MODE=auto

# LLM for KPI and covenant extraction, event classification and draft memos (milestone 3+)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Bolagsverket "Värdefulla datamängder" API, OAuth2 client credentials (milestone 4)
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# Path to Bolagsverket's free bulk file of all companies, downloaded in a browser
BOLAGSVERKET_BULKFILE=

# Optional contact appended to the HTTP user agent, e.g. an email or repo URL
HTTP_CONTACT=
